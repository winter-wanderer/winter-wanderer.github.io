---
layout: base.njk
navSection: home
---
<main id="main" class="page page-empty">
  <section class="topics-section" aria-label="글 주제">
    {% include "category-nav.njk" %}
  </section>
  <figure class="home-quote" aria-label="명언" lang="en">
    <span class="quote-decoration quote-decoration-open" aria-hidden="true">“</span>
    <blockquote><p id="quote-text">To Travel is to Live</p></blockquote>
    <figcaption id="quote-author">Hans Christian Andersen</figcaption>
    <span class="quote-decoration quote-decoration-close" aria-hidden="true">”</span>
  </figure>
  <section class="shelf-section" id="shelves" aria-labelledby="shelf-title">
    <div class="section-heading"><h1 id="shelf-title">최근 글</h1><a class="all-posts-link" href="/posts/">전체 글 보기 <span aria-hidden="true">→</span></a></div>
    <div class="book-shelf" id="book-shelf">
      {% for post in collections.posts %}{% if loop.index <= 3 %}
      <article class="home-post-card"><a href="{{ post.url }}"><div><h2>{{ post.data.title }}</h2><p>{{ post.data.summary }}</p></div><span aria-hidden="true">↗</span></a></article>
      {% endif %}
      {% else %}<p class="empty-state">아직 글이 없습니다.</p>{% endfor %}
    </div>
  </section>
</main>

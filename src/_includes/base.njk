<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <meta name="description" content="{{ summary or description or 'snowhaven의 개인 블로그.' }}">
  <meta name="theme-color" content="#17191a">
  <meta name="color-scheme" content="dark">
  <title>{% if title %}{{ title }} · {% endif %}snowhaven</title>
  <link rel="icon" type="image/png" href="/snowhaven-logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800&family=Noto+Serif+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <a class="skip-link" href="#main">본문으로 이동</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="snowhaven 홈"><img class="brand-logo" src="/snowhaven-logo.png" alt="" width="48" height="48" decoding="async"><span>snowhaven</span></a>
      <nav aria-label="Main navigation"><a{% if navSection == 'home' %} class="nav-active" aria-current="page"{% endif %} href="/">HOME</a><a{% if navSection == 'posts' %} class="nav-active" aria-current="page"{% endif %} href="/posts/">POSTS</a><a{% if navSection == 'categories' %} class="nav-active" aria-current="page"{% endif %} href="/categories/">CATEGORIES</a><a{% if navSection == 'tags' %} class="nav-active" aria-current="page"{% endif %} href="/tags/">TAGS</a><a{% if navSection == 'about' %} class="nav-active" aria-current="page"{% endif %} href="/about/">ABOUT</a><a href="https://github.com/winter-wanderer" target="_blank" rel="noopener noreferrer">GITHUB <span aria-hidden="true">↗</span></a></nav>
    </div>
  </header>
  {{ content | safe }}
  <footer class="site-footer"><a href="#main">맨 위로 ↑</a></footer>
  {% if navSection == 'home' %}<script src="/quotes.js"></script>{% endif %}
</body>
</html>
